{
  "family": "skeletonApply",
  "description": "Apply-engine conformance for the six skeleton tree ops (InsertChild, RemoveNode, MoveNode, ReorderChildren, Batch, and since Phase 250 UpdateNode): one vector per validator clause per op, Batch's all-or-nothing atomicity, and the three id-collision shapes. Each vector carries an `input.tree` and an `input.op` as canonical JSON STRINGS. The tree envelope is the WITNESS SURFACE and nothing else — `{\"children\":[…],\"id\":…,\"kind\":…}` — because the ops read structure and, for UpdateNode, the `kind` it rewrites in place and nothing else; a host runs the family by mapping those three members onto its own node type, not by decoding its own wire format. An `accept` vector requires the host's applied tree to encode byte-for-byte to `expected.tree`, whose `expected.hash` is `sha256:` plus lowercase hex over exactly those bytes. A `reject` vector requires the host to refuse, with `expected.hosts` naming the code each host raises for that clause — every non-reference host carries the same twelve-code ApplyErrorCode vocabulary, so the mapping is a correspondence and never a rename: Core says DuplicateId where they say DuplicateNodeId. Two vectors carry an `expected.hostsNote` and NO mapping, because there is nothing to map: one is a refusal the other hosts do not make at all, the other is a wrapper shape they do not share. WHAT THIS FAMILY DOES NOT PIN, deliberately: the ORDER clauses are checked in (Core checks the root and existence before the cycle guard; at least one host checks the cycle guard first, so a vector that breaks two clauses at once would compare implementations rather than the contract, and none does); `UnknownNode`'s enumeration of addressable ids and `ReorderMismatch`'s two orders, which are evidence for a class rather than the class; and the container-capability refusal (NotAContainer / ChildlessKind), which is a domain predicate handed to the engine rather than a property of a wire document. There is no kitVersion stamp: these are the apply SEMANTICS, not one kit's sampled answers, and the reference recomputes every expectation on each run.",
  "vectors": [
    { "id": "insert-accept-leaf", "case": "InsertChild", "description": "InsertChild APPENDS a fresh leaf to the named parent's child list.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"n1\",\"kind\":\"para\"},\"parent\":\"b\"}" }, "expected": { "verdict": "accept", "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"n1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "hash": "sha256:b98b81a39cb58f690d0faf4f1467743e5fc2942e8cdca988b7c0f62a1381b756" } },
    { "id": "insert-accept-subtree", "case": "InsertChild", "description": "A whole subtree grafts in one op; every id in it is fresh.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"insertChild\",\"node\":{\"children\":[{\"children\":[],\"id\":\"s1a\",\"kind\":\"para\"}],\"id\":\"s1\",\"kind\":\"section\"},\"parent\":\"root\"}" }, "expected": { "verdict": "accept", "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"s1a\",\"kind\":\"para\"}],\"id\":\"s1\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "hash": "sha256:3213f93c27b7287709a3a12df28754ae48eaefee2b052ced5e374c627c0307f2" } },
    { "id": "insert-reject-duplicate-own-id", "case": "InsertChild", "description": "The graft's OWN id is already in the tree.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},\"parent\":\"b\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"duplicateId\",\"id\":\"a1\"}", "hosts": { "fuaran-ts": "DuplicateNodeId", "fuaran-py": "DuplicateNodeId", "fuaran-go": "DuplicateNodeId", "fuaran-rs": "DuplicateNodeId" } } },
    { "id": "insert-reject-duplicate-descendant-id", "case": "InsertChild", "description": "A DESCENDANT of the graft carries an id the tree already holds (Phase 137).", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"insertChild\",\"node\":{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"}],\"id\":\"n2\",\"kind\":\"section\"},\"parent\":\"b\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"duplicateId\",\"id\":\"a1\"}", "hosts": { "fuaran-ts": "DuplicateNodeId", "fuaran-py": "DuplicateNodeId", "fuaran-go": "DuplicateNodeId", "fuaran-rs": "DuplicateNodeId" } } },
    { "id": "insert-reject-duplicate-within-graft", "case": "InsertChild", "description": "The graft repeats an id within ITSELF; nothing in it is in the tree (Phase 137).", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"insertChild\",\"node\":{\"children\":[{\"children\":[],\"id\":\"t\",\"kind\":\"para\"},{\"children\":[],\"id\":\"t\",\"kind\":\"para\"}],\"id\":\"n3\",\"kind\":\"section\"},\"parent\":\"b\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"duplicateId\",\"id\":\"t\"}", "hosts": {}, "hostsNote": "NO HOST MAPPING, and this is a real divergence rather than a gap in the table. fuaran-ts, fuaran-py, fuaran-go and fuaran-rs all seed the duplicate scan from the ROOT's ids alone, so a graft that repeats an id WITHIN ITSELF — with nothing in common with the tree — is ACCEPTED on all four, leaving the tree holding one id twice. Core refuses it. A host adopting this vector adds the check; it does not translate a code it has." } },
    { "id": "insert-reject-unknown-parent", "case": "InsertChild", "description": "The named parent is not in the tree.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"n4\",\"kind\":\"para\"},\"parent\":\"nope\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"unknownNode\",\"target\":\"nope\"}", "hosts": { "fuaran-ts": "ParentNotFound", "fuaran-py": "ParentNotFound", "fuaran-go": "ParentNotFound", "fuaran-rs": "ParentNotFound" } } },
    { "id": "remove-accept", "case": "RemoveNode", "description": "The target leaves its parent's child list.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"removeNode\",\"target\":\"a1\"}" }, "expected": { "verdict": "accept", "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "hash": "sha256:45bdf0e6b9e42ebd9bb3852bff7821d78f8102b74bc0eb5d16f4bf8a1311037a" } },
    { "id": "remove-reject-root", "case": "RemoveNode", "description": "The root cannot be removed — there would be no tree left to address.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"removeNode\",\"target\":\"root\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"cannotRemoveRoot\"}", "hosts": { "fuaran-ts": "KindMismatch", "fuaran-py": "KindMismatch", "fuaran-go": "KindMismatch", "fuaran-rs": "KindMismatch" } } },
    { "id": "remove-reject-unknown", "case": "RemoveNode", "description": "The target is not in the tree.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"removeNode\",\"target\":\"nope\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"unknownNode\",\"target\":\"nope\"}", "hosts": { "fuaran-ts": "NodeNotFound", "fuaran-py": "NodeNotFound", "fuaran-go": "NodeNotFound", "fuaran-rs": "NodeNotFound" } } },
    { "id": "move-accept", "case": "MoveNode", "description": "The subtree is detached and APPENDED under the new parent; order is a separate op.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"moveNode\",\"newParent\":\"b\",\"target\":\"a1\"}" }, "expected": { "verdict": "accept", "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "hash": "sha256:fe1f3b6c765a9149a42df897f634ee1ee44165363261df1edfe93ef41e62b0fc" } },
    { "id": "move-reject-root", "case": "MoveNode", "description": "The root cannot be moved, for the reason it cannot be removed.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"moveNode\",\"newParent\":\"a\",\"target\":\"root\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"cannotRemoveRoot\"}", "hosts": { "fuaran-ts": "KindMismatch", "fuaran-py": "KindMismatch", "fuaran-go": "KindMismatch", "fuaran-rs": "KindMismatch" } } },
    { "id": "move-reject-unknown-target", "case": "MoveNode", "description": "The subtree to move is not in the tree.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"moveNode\",\"newParent\":\"a\",\"target\":\"nope\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"unknownNode\",\"target\":\"nope\"}", "hosts": { "fuaran-ts": "NodeNotFound", "fuaran-py": "NodeNotFound", "fuaran-go": "NodeNotFound", "fuaran-rs": "NodeNotFound" } } },
    { "id": "move-reject-unknown-new-parent", "case": "MoveNode", "description": "The destination parent is not in the tree.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"moveNode\",\"newParent\":\"nope\",\"target\":\"a1\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"unknownNode\",\"target\":\"nope\"}", "hosts": { "fuaran-ts": "ParentNotFound", "fuaran-py": "ParentNotFound", "fuaran-go": "ParentNotFound", "fuaran-rs": "ParentNotFound" } } },
    { "id": "move-reject-under-self", "case": "MoveNode", "description": "A node cannot become its own parent.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"moveNode\",\"newParent\":\"a\",\"target\":\"a\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"wouldNestUnderSelf\",\"target\":\"a\"}", "hosts": { "fuaran-ts": "KindMismatch", "fuaran-py": "KindMismatch", "fuaran-go": "KindMismatch", "fuaran-rs": "KindMismatch" } } },
    { "id": "move-reject-under-descendant", "case": "MoveNode", "description": "A node cannot move under one of its own descendants — that is a cycle, not a tree.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"moveNode\",\"newParent\":\"a1\",\"target\":\"a\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"wouldNestUnderSelf\",\"target\":\"a\"}", "hosts": { "fuaran-ts": "KindMismatch", "fuaran-py": "KindMismatch", "fuaran-go": "KindMismatch", "fuaran-rs": "KindMismatch" } } },
    { "id": "reorder-accept", "case": "ReorderChildren", "description": "Order is stated by naming ids, so it is checkable where an index would not be.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"reorderChildren\",\"order\":[\"a2\",\"a1\"],\"parent\":\"a\"}" }, "expected": { "verdict": "accept", "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "hash": "sha256:da16b8c1e7b0a4a89750e1e94a169d3207430f1fbfda653c6ac607af579a1621" } },
    { "id": "reorder-reject-unknown-parent", "case": "ReorderChildren", "description": "The named parent is not in the tree.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"reorderChildren\",\"order\":[\"a1\"],\"parent\":\"nope\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"unknownNode\",\"target\":\"nope\"}", "hosts": { "fuaran-ts": "ParentNotFound", "fuaran-py": "ParentNotFound", "fuaran-go": "ParentNotFound", "fuaran-rs": "ParentNotFound" } } },
    { "id": "reorder-reject-not-a-permutation", "case": "ReorderChildren", "description": "The proposed order is not a permutation of the parent's current children.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"reorderChildren\",\"order\":[\"a1\"],\"parent\":\"a\"}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"reorderMismatch\",\"parent\":\"a\"}", "hosts": { "fuaran-ts": "OrderingMismatch", "fuaran-py": "OrderingMismatch", "fuaran-go": "OrderingMismatch", "fuaran-rs": "OrderingMismatch" } } },
    { "id": "batch-accept-insert-then-order", "case": "Batch", "description": "Membership and order are separate concerns: placing a node anywhere but last is InsertChild then ReorderChildren.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"batch\",\"ops\":[{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"n5\",\"kind\":\"para\"},\"parent\":\"b\"},{\"$type\":\"reorderChildren\",\"order\":[\"n5\",\"b1\"],\"parent\":\"b\"}]}" }, "expected": { "verdict": "accept", "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"n5\",\"kind\":\"para\"},{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "hash": "sha256:db12181dc25354d7c5755534a2a89dc7d7078e71587d0bc6ae5d8c09678b0372" } },
    { "id": "batch-first-op-alone-accept", "case": "InsertChild", "description": "The first op of the atomicity pair below, ON ITS OWN. It succeeds — which is what makes the pair evidence of atomicity rather than of a single refusal.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"n6\",\"kind\":\"para\"},\"parent\":\"b\"}" }, "expected": { "verdict": "accept", "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"n6\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "hash": "sha256:6a3f233f7c424b687d6612ca2139a2e2d8bc157a3d86bb7f19226615ffb9f832" } },
    { "id": "batch-reject-all-or-nothing", "case": "Batch", "description": "All-or-nothing: the first op would succeed alone (see the vector above), the second refuses, and the tree is the one the batch started from.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"batch\",\"ops\":[{\"$type\":\"insertChild\",\"node\":{\"children\":[],\"id\":\"n6\",\"kind\":\"para\"},\"parent\":\"b\"},{\"$type\":\"removeNode\",\"target\":\"nope\"}]}" }, "expected": { "verdict": "reject", "rejection": "{\"$type\":\"unknownNode\",\"target\":\"nope\"}", "hosts": {}, "hostsNote": "NO DIRECT MAPPING: fuaran-ts, fuaran-py, fuaran-go and fuaran-rs WRAP an inner failure as `BatchAborted` carrying the inner op's index, discarding the inner class; Core returns the inner rejection itself. A host asserts the wrapper and the index — `BatchAborted` at index 1 here — and the tree unchanged; the inner class is not comparable across the two shapes." } },
    { "id": "update-accept-leaf", "case": "UpdateNode", "description": "The node whose id the payload carries takes the payload's content in place: same id, same position among its siblings.", "input": { "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"para\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "op": "{\"$type\":\"updateNode\",\"node\":{\"children\":[],\"id\":\"a1\",\"kind\":\"heading\"}}" }, "expected": { "verdict": "accept", "tree": "{\"children\":[{\"children\":[{\"children\":[],\"id\":\"a1\",\"kind\":\"heading\"},{\"children\":[],\"id\":\"a2\",\"kind\":\"para\"}],\"id\":\"a\",\"kind\":\"section\"},{\"children\":[{\"children\":[],\"id\":\"b1\",\"kind\":\"para\"}],\"id\":\"b\",\"kind\":\"section\"}],\"id\":\"root\",\"kind\":\"doc\"}", "hash": "sha256:d7efb966be628c33910c36489d5df6ab502aa0d1335ea4d0a637be0ff8864300" } },
