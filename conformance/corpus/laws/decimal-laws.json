    { "id": "add-widening-carry", "case": "add", "input": { "a": "999", "b": "1" }, "expected": { "verdict": "accept", "sum": "1000" } },
    { "id": "add-narrowing-borrow", "case": "add", "input": { "a": "1000", "b": "-0.001" }, "expected": { "verdict": "accept", "sum": "999.999" } },
    { "id": "add-cancel-to-unsigned-zero", "case": "add", "input": { "a": "1.5", "b": "-1.50" }, "expected": { "verdict": "accept", "sum": "0" } },
    { "id": "add-mixed-negative-larger-first", "case": "add", "input": { "a": "-5", "b": "3" }, "expected": { "verdict": "accept", "sum": "-2" } },
    { "id": "add-mixed-negative-larger-second", "case": "add", "input": { "a": "3", "b": "-5" }, "expected": { "verdict": "accept", "sum": "-2" } },
    { "id": "add-mixed-positive-larger-first", "case": "add", "input": { "a": "5", "b": "-3" }, "expected": { "verdict": "accept", "sum": "2" } },
    { "id": "add-mixed-positive-larger-second", "case": "add", "input": { "a": "-3", "b": "5" }, "expected": { "verdict": "accept", "sum": "2" } },
    { "id": "add-both-negative", "case": "add", "input": { "a": "-1.5", "b": "-2.75" }, "expected": { "verdict": "accept", "sum": "-4.25" } },
    { "id": "add-scale-past-host-decimal", "case": "add", "input": { "a": "0.0000000000000000000000000000001", "b": "1" }, "expected": { "verdict": "accept", "sum": "1.0000000000000000000000000000001" } },
    { "id": "add-magnitude-past-host-decimal", "case": "add", "input": { "a": "99999999999999999999999999999999999999", "b": "1" }, "expected": { "verdict": "accept", "sum": "100000000000000000000000000000000000000" } },
    { "id": "add-refused", "case": "add", "input": { "a": "1", "b": ".5" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "to-float-tenth", "case": "toFloat", "input": { "text": "0.10" }, "expected": { "verdict": "accept", "float": "0.1" } },
    { "id": "to-float-past-2-53", "case": "toFloat", "input": { "text": "9007199254740993" }, "expected": { "verdict": "accept", "float": "9007199254740992" } },
    { "id": "to-float-past-float-range", "case": "toFloat", "input": { "text": "" }, "expected": { "verdict": "reject", "error": "pastFloatRange" } },
    { "id": "to-float-refused", "case": "toFloat", "input": { "text": "1e3" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "decode-canonicalises", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}],\"columns\":{\"c\":{\"values\":[\"012.50\",\"-0\",\"3.000\"],\"validity\":[true,true,true]}}}" }, "expected": { "verdict": "accept", "canonical": "{\"columns\":{\"c\":{\"validity\":[true,true,true],\"values\":[\"12.5\",\"0\",\"3\"]}},\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}]}" } },
    { "id": "decode-integer-token", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}],\"columns\":{\"c\":{\"values\":[42,-7,0],\"validity\":[true,true,true]}}}" }, "expected": { "verdict": "accept", "canonical": "{\"columns\":{\"c\":{\"validity\":[true,true,true],\"values\":[\"42\",\"-7\",\"0\"]}},\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}]}" } },
    { "id": "decode-integer-token-past-int32", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}],\"columns\":{\"c\":{\"values\":[3000000000,-9007199254740992],\"validity\":[true,true]}}}" }, "expected": { "verdict": "accept", "canonical": "{\"columns\":{\"c\":{\"validity\":[true,true],\"values\":[\"3000000000\",\"-9007199254740992\"]}},\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}]}" } },
    { "id": "decode-whole-exponent-token", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}],\"columns\":{\"c\":{\"values\":[3e9],\"validity\":[true]}}}" }, "expected": { "verdict": "accept", "canonical": "{\"columns\":{\"c\":{\"validity\":[true],\"values\":[\"3000000000\"]}},\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}]}" } },
    { "id": "decode-refuses-fractional-token", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}],\"columns\":{\"c\":{\"values\":[3.5],\"validity\":[true]}}}" }, "expected": { "verdict": "reject", "error": "TypeMismatch" } },
    { "id": "decode-refuses-integer-token-past-2-53", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}],\"columns\":{\"c\":{\"values\":[9007199254740994],\"validity\":[true]}}}" }, "expected": { "verdict": "reject", "error": "TypeMismatch" } },
    { "id": "decode-refuses-whole-float-past-2-53", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}],\"columns\":{\"c\":{\"values\":[1e300],\"validity\":[true]}}}" }, "expected": { "verdict": "reject", "error": "TypeMismatch" } },
    { "id": "decode-refuses-exponent-text", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}],\"columns\":{\"c\":{\"values\":[\"1e3\"],\"validity\":[true]}}}" }, "expected": { "verdict": "reject", "error": "MalformedShape" } },
    { "id": "decode-refuses-plus-text", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}],\"columns\":{\"c\":{\"values\":[\"+1\"],\"validity\":[true]}}}" }, "expected": { "verdict": "reject", "error": "MalformedShape" } },
    { "id": "decode-refuses-bool", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}],\"columns\":{\"c\":{\"values\":[true],\"validity\":[true]}}}" }, "expected": { "verdict": "reject", "error": "TypeMismatch" } },
    { "id": "encode-canonical", "case": "codecEncode", "input": { "cells": [{ "kind": "decimal", "text": "12.5" }, { "kind": "null" }, { "kind": "decimal", "text": "-0.001" }, { "kind": "int", "text": "7" }] }, "expected": { "verdict": "accept", "canonical": "{\"columns\":{\"c\":{\"validity\":[true,false,true,true],\"values\":[\"12.5\",\"0\",\"-0.001\",\"7\"]}},\"schema\":[{\"name\":\"c\",\"type\":\"decimal\"}]}" } },
    { "id": "encode-refuses-non-canonical", "case": "codecEncode", "input": { "cells": [{ "kind": "decimal", "text": "12.50" }] }, "expected": { "verdict": "reject", "error": "MalformedShape" } },
    { "id": "aggregate-sum", "case": "aggregate", "input": { "fn": "sum", "cells": [{ "kind": "decimal", "text": "0.1" }, { "kind": "decimal", "text": "0.2" }, { "kind": "null" }, { "kind": "decimal", "text": "-0.3" }, { "kind": "decimal", "text": "1.50" }, { "kind": "decimal", "text": "1.5" }, { "kind": "int", "text": "2" }] }, "expected": { "verdict": "accept", "token": "m:5" } },
    { "id": "aggregate-min", "case": "aggregate", "input": { "fn": "min", "cells": [{ "kind": "decimal", "text": "0.1" }, { "kind": "decimal", "text": "0.2" }, { "kind": "null" }, { "kind": "decimal", "text": "-0.3" }, { "kind": "decimal", "text": "1.50" }, { "kind": "decimal", "text": "1.5" }, { "kind": "int", "text": "2" }] }, "expected": { "verdict": "accept", "token": "m:-0.3" } },
    { "id": "aggregate-max", "case": "aggregate", "input": { "fn": "max", "cells": [{ "kind": "decimal", "text": "0.1" }, { "kind": "decimal", "text": "0.2" }, { "kind": "null" }, { "kind": "decimal", "text": "-0.3" }, { "kind": "decimal", "text": "1.50" }, { "kind": "decimal", "text": "1.5" }, { "kind": "int", "text": "2" }] }, "expected": { "verdict": "accept", "token": "m:2" } },
    { "id": "aggregate-mean", "case": "aggregate", "input": { "fn": "mean", "cells": [{ "kind": "decimal", "text": "0.1" }, { "kind": "decimal", "text": "0.2" }, { "kind": "null" }, { "kind": "decimal", "text": "-0.3" }, { "kind": "decimal", "text": "1.50" }, { "kind": "decimal", "text": "1.5" }, { "kind": "int", "text": "2" }] }, "expected": { "verdict": "accept", "token": "f:0.8333333333333334" } },
