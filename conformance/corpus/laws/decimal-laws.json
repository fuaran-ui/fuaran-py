{
  "family": "decimal",
  "kitVersion": "0.38.1",
  "description": "The exact decimal (D72): authored inputs over every behaviour a host mirrors, each `expected` computed by calling the pinned kit. No seed: nothing is drawn. Every vector expects `verdict` accept or reject; a reject names its class. `canonical` reads `text` (the grammar -?[0-9]+(\\.[0-9]+)? with ASCII digits only) and expects the canonical form: no leading zero, no trailing fraction zero, no point on a whole number, no sign on zero. `compare` expects the numeric `order` of `a` and `b` as -1, 0 or 1. `add` expects the exact canonical `sum`. `toFloat` expects the nearest double in the canonical float layout, and rejects a value past the float range rather than answering an infinity. `codecDecode` decodes a one-column decimal `document` and expects its canonical re-encoding; a decimal is a JSON string on the wire, an integer token is read exactly, and a fractional token or a whole token past 2^53 is refused. `codecEncode` builds column `c` of type decimal from `cells` ({kind, text}; a null cell has no text) and expects the guarded encode's canonical bytes, or the refusal of a cell whose text is not canonical. `aggregate` folds `fn` over the same column and expects the result cell's token (`m:` a decimal, `i:` an int, `f:` a float): Sum is exact, Min and Max return the winning cell as it stands, Mean, Median and StdDev (the population form) read each value at its nearest double, and a value past the float range is refused for them.",
  "vectors": [
    { "id": "canonical-refused-empty", "case": "canonical", "input": { "text": "" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-lone-minus", "case": "canonical", "input": { "text": "-" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-leading-plus", "case": "canonical", "input": { "text": "+1" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-double-minus", "case": "canonical", "input": { "text": "--1" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-bare-point-leading", "case": "canonical", "input": { "text": ".5" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-bare-point-trailing", "case": "canonical", "input": { "text": "5." }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-minus-bare-point", "case": "canonical", "input": { "text": "-.5" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-two-points", "case": "canonical", "input": { "text": "1.2.3" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-exponent", "case": "canonical", "input": { "text": "1e3" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-exponent-upper", "case": "canonical", "input": { "text": "1.5E-2" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-separator-comma", "case": "canonical", "input": { "text": "1,000" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-separator-underscore", "case": "canonical", "input": { "text": "1_000" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-leading-space", "case": "canonical", "input": { "text": " 1" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-trailing-space", "case": "canonical", "input": { "text": "1 " }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-hex", "case": "canonical", "input": { "text": "0x10" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-nan", "case": "canonical", "input": { "text": "NaN" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-refused-arabic-indic-digit", "case": "canonical", "input": { "text": "١" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
    { "id": "canonical-already-canonical", "case": "canonical", "input": { "text": "12.5" }, "expected": { "verdict": "accept", "canonical": "12.5" } },
    { "id": "canonical-zero", "case": "canonical", "input": { "text": "0" }, "expected": { "verdict": "accept", "canonical": "0" } },
    { "id": "canonical-leading-zeros", "case": "canonical", "input": { "text": "007" }, "expected": { "verdict": "accept", "canonical": "7" } },
    { "id": "canonical-trailing-zeros", "case": "canonical", "input": { "text": "12.50" }, "expected": { "verdict": "accept", "canonical": "12.5" } },
    { "id": "canonical-zero-fraction", "case": "canonical", "input": { "text": "3.000" }, "expected": { "verdict": "accept", "canonical": "3" } },
    { "id": "canonical-negative-zero", "case": "canonical", "input": { "text": "-0" }, "expected": { "verdict": "accept", "canonical": "0" } },
    { "id": "canonical-negative-zero-fraction", "case": "canonical", "input": { "text": "-0.000" }, "expected": { "verdict": "accept", "canonical": "0" } },
    { "id": "canonical-negative-both-sides", "case": "canonical", "input": { "text": "-012.340" }, "expected": { "verdict": "accept", "canonical": "-12.34" } },
    { "id": "canonical-thirty-one-places", "case": "canonical", "input": { "text": "0.0000000000000000000000000000001" }, "expected": { "verdict": "accept", "canonical": "0.0000000000000000000000000000001" } },
    { "id": "canonical-forty-digits", "case": "canonical", "input": { "text": "1234567890123456789012345678901234567890.50" }, "expected": { "verdict": "accept", "canonical": "1234567890123456789012345678901234567890.5" } },
    { "id": "compare-negative-below-positive", "case": "compare", "input": { "a": "-1", "b": "1" }, "expected": { "verdict": "accept", "order": -1 } },
    { "id": "compare-signed-zeros-equal", "case": "compare", "input": { "a": "-0", "b": "0.0" }, "expected": { "verdict": "accept", "order": 0 } },
    { "id": "compare-negatives-reversed", "case": "compare", "input": { "a": "-2", "b": "-10" }, "expected": { "verdict": "accept", "order": 1 } },
    { "id": "compare-integer-width", "case": "compare", "input": { "a": "10", "b": "9" }, "expected": { "verdict": "accept", "order": 1 } },
    { "id": "compare-fraction-place", "case": "compare", "input": { "a": "0.1", "b": "0.09" }, "expected": { "verdict": "accept", "order": 1 } },
    { "id": "compare-negative-fraction-place", "case": "compare", "input": { "a": "-0.1", "b": "-0.09" }, "expected": { "verdict": "accept", "order": -1 } },
    { "id": "compare-equal-spellings", "case": "compare", "input": { "a": "1.50", "b": "001.5" }, "expected": { "verdict": "accept", "order": 0 } },
    { "id": "compare-one-float-tenth", "case": "compare", "input": { "a": "0.1", "b": "0.1000000000000000055511151231257827" }, "expected": { "verdict": "accept", "order": -1 } },
    { "id": "compare-one-float-past-2-53", "case": "compare", "input": { "a": "9007199254740993", "b": "9007199254740992" }, "expected": { "verdict": "accept", "order": 1 } },
    { "id": "compare-refused", "case": "compare", "input": { "a": "1e3", "b": "1" }, "expected": { "verdict": "reject", "error": "notDecimal" } },
