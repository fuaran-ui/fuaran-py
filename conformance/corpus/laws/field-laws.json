    { "id": "delta-no-metadata", "case": "delta", "input": { "old": [{"name":"a","type":"int"},{"name":"b","type":"string"}], "target": [{"name":"b","type":"string"},{"name":"a","type":"float"}] }, "expected": { "verdict": "accept", "canonical": "{\"added\":[],\"order\":[\"b\",\"a\"],\"removed\":[],\"reordered\":true,\"retyped\":[{\"from\":\"int\",\"name\":\"a\",\"to\":\"float\"}]}", "patched": [{"name":"b","type":"string"},{"name":"a","type":"float"}] }, "answeredBy": ["reference"] },
    { "id": "delta-unit-changed", "case": "delta", "input": { "old": [{"name":"m","type":"float","unit":"kg"}], "target": [{"name":"m","type":"float","unit":"[lb_av]"}] }, "expected": { "verdict": "accept", "canonical": "{\"added\":[],\"amended\":[{\"from\":\"kg\",\"member\":\"unit\",\"name\":\"m\",\"to\":\"[lb_av]\"}],\"order\":[],\"removed\":[],\"reordered\":false,\"retyped\":[]}", "patched": [{"name":"m","type":"float","unit":"[lb_av]"}] }, "answeredBy": ["reference"] },
    { "id": "delta-unit-added-and-label", "case": "delta", "input": { "old": [{"name":"m","type":"float"}], "target": [{"label":"Mass","name":"m","type":"float","unit":"kg"}] }, "expected": { "verdict": "accept", "canonical": "{\"added\":[],\"amended\":[{\"member\":\"unit\",\"name\":\"m\",\"to\":\"kg\"},{\"member\":\"label\",\"name\":\"m\",\"to\":\"Mass\"}],\"order\":[],\"removed\":[],\"reordered\":false,\"retyped\":[]}", "patched": [{"label":"Mass","name":"m","type":"float","unit":"kg"}] }, "answeredBy": ["reference"] },
