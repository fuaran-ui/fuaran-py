    { "id": "classify-unit-replaced-depended", "case": "classify", "input": { "old": [{"name":"m","type":"float","unit":"kg"}], "target": [{"name":"m","type":"float","unit":"[lb_av]"}], "dependsOn": ["m"] }, "expected": { "verdict": "accept", "compat": "breaking" }, "answeredBy": ["reference"] },
