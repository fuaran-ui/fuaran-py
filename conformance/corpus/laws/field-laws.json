    { "id": "classify-label-changed-depended", "case": "classify", "input": { "old": [{"name":"m","type":"float","unit":"kg"}], "target": [{"label":"Mass","name":"m","type":"float","unit":"kg"}], "dependsOn": ["m"] }, "expected": { "verdict": "accept", "compat": "compatible" }, "answeredBy": ["reference"] },
