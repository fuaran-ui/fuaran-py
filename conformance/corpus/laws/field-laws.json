{
  "family": "fieldLaws",
  "kitVersion": "0.41.0",
  "description": "The schema field (Phase 427): a column's name and type, and the metadata that says what it means — an optional unit (the canonical text of a unit the unit algebra parses), a label, a description, and an extension object of string members a host preserves verbatim. Authored inputs, each `expected` computed by calling the pinned kit; no seed. `fieldEncode` builds a field from its members (`name`, `type`, and whichever of `unit`, `label`, `description`, `ext` are given) and expects the schema entry's canonical bytes: the members the field states and no other, keys sorted, so an entry without metadata is `{name, type}`. `codecDecode` decodes a zero-row `document` and expects its canonical re-encoding — a parseable unit spelling is read to the unit and written back canonical, an empty `ext` is dropped, an unknown member is read past — or the refusal's class: a unit the algebra does not parse, a non-string `unit`, `label` or `description`, an `ext` that is not an object, and an `ext` member that is not a string are each `MalformedShape`. `fingerprint` reads a `schema` (an array of entries) and expects its FNV-1a fingerprint: a schema without metadata has the fingerprint it had before this phase, and metadata moves it. `delta` reads `old` and `target` schemas and expects the canonical bytes of the delta between them (`amended` present only when a member moved) and `patched`, the schema replaying that delta over `old` yields, which is `target`. `classify` reads the same pair and `dependsOn` and expects `compat`: `breaking` when a depended-on column's stated unit was replaced or withdrawn (or it was removed or narrowed), `unknown` when only a depended-on column's extension member moved, else `compatible`.",
  "vectors": [
    { "id": "encode-bare", "case": "fieldEncode", "input": { "name": "n", "type": "int" }, "expected": { "verdict": "accept", "canonical": "{\"name\":\"n\",\"type\":\"int\"}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "encode-unit-only", "case": "fieldEncode", "input": { "name": "d", "type": "float", "unit": "m" }, "expected": { "verdict": "accept", "canonical": "{\"name\":\"d\",\"type\":\"float\",\"unit\":\"m\"}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "encode-every-member", "case": "fieldEncode", "input": { "name": "mass", "type": "float", "unit": "kg", "label": "Payload mass", "description": "The mass carried, measured at departure.", "ext": { "vendor.format": "0.00" } }, "expected": { "verdict": "accept", "canonical": "{\"description\":\"The mass carried, measured at departure.\",\"ext\":{\"vendor.format\":\"0.00\"},\"label\":\"Payload mass\",\"name\":\"mass\",\"type\":\"float\",\"unit\":\"kg\"}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "encode-empty-label", "case": "fieldEncode", "input": { "name": "n", "type": "int", "label": "" }, "expected": { "verdict": "accept", "canonical": "{\"label\":\"\",\"name\":\"n\",\"type\":\"int\"}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "encode-currency-and-prefix", "case": "fieldEncode", "input": { "name": "price", "type": "decimal", "unit": "c[GBP]" }, "expected": { "verdict": "accept", "canonical": "{\"name\":\"price\",\"type\":\"decimal\",\"unit\":\"c[GBP]\"}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "encode-derived-unit", "case": "fieldEncode", "input": { "name": "v", "type": "float", "unit": "m/s2" }, "expected": { "verdict": "accept", "canonical": "{\"name\":\"v\",\"type\":\"float\",\"unit\":\"m/s2\"}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "encode-dimensionless", "case": "fieldEncode", "input": { "name": "ratio", "type": "float", "unit": "1" }, "expected": { "verdict": "accept", "canonical": "{\"name\":\"ratio\",\"type\":\"float\",\"unit\":\"1\"}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "encode-ext-keys-sorted", "case": "fieldEncode", "input": { "name": "x", "type": "string", "ext": { "other.z": "3", "vendor.a": "1", "vendor.b": "2" } }, "expected": { "verdict": "accept", "canonical": "{\"ext\":{\"other.z\":\"3\",\"vendor.a\":\"1\",\"vendor.b\":\"2\"},\"name\":\"x\",\"type\":\"string\"}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-bare", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\"}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "accept", "canonical": "{\"columns\":{\"c\":{\"validity\":[],\"values\":[]}},\"schema\":[{\"name\":\"c\",\"type\":\"float\"}]}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-every-member", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"unit\":\"kg\",\"label\":\"Payload mass\",\"description\":\"A sentence.\",\"ext\":{\"vendor.format\":\"0.00\"}}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "accept", "canonical": "{\"columns\":{\"c\":{\"validity\":[],\"values\":[]}},\"schema\":[{\"description\":\"A sentence.\",\"ext\":{\"vendor.format\":\"0.00\"},\"label\":\"Payload mass\",\"name\":\"c\",\"type\":\"float\",\"unit\":\"kg\"}]}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-canonicalises-unit-order", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"unit\":\"s-1.m\"}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "accept", "canonical": "{\"columns\":{\"c\":{\"validity\":[],\"values\":[]}},\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"unit\":\"m/s\"}]}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-canonicalises-unit-division", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"unit\":\"m/s/s\"}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "accept", "canonical": "{\"columns\":{\"c\":{\"validity\":[],\"values\":[]}},\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"unit\":\"m/s2\"}]}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-canonicalises-unit-alias", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"unit\":\"l\"}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "accept", "canonical": "{\"columns\":{\"c\":{\"validity\":[],\"values\":[]}},\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"unit\":\"L\"}]}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-empty-ext", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"ext\":{}}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "accept", "canonical": "{\"columns\":{\"c\":{\"validity\":[],\"values\":[]}},\"schema\":[{\"name\":\"c\",\"type\":\"float\"}]}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-unknown-member-read-past", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"nullable\":true}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "accept", "canonical": "{\"columns\":{\"c\":{\"validity\":[],\"values\":[]}},\"schema\":[{\"name\":\"c\",\"type\":\"float\"}]}" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-refuses-unknown-unit", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"unit\":\"furlong\"}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "reject", "error": "MalformedShape" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-refuses-empty-unit", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"unit\":\"\"}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "reject", "error": "MalformedShape" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-refuses-annotation-unit", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"unit\":\"m{tall}\"}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "reject", "error": "MalformedShape" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-refuses-affine-unit", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"unit\":\"Cel\"}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "reject", "error": "MalformedShape" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-refuses-unit-not-string", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"unit\":1}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "reject", "error": "MalformedShape" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-refuses-label-not-string", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"label\":[]}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "reject", "error": "MalformedShape" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-refuses-description-not-string", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"description\":7}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "reject", "error": "MalformedShape" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-refuses-ext-not-object", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"ext\":[\"a\"]}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "reject", "error": "MalformedShape" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "decode-refuses-ext-member-not-string", "case": "codecDecode", "input": { "document": "{\"schema\":[{\"name\":\"c\",\"type\":\"float\",\"ext\":{\"vendor.n\":1}}],\"columns\":{\"c\":{\"values\":[],\"validity\":[]}}}" }, "expected": { "verdict": "reject", "error": "MalformedShape" }, "answeredBy": ["reference","model:WireColumn"] },
    { "id": "fingerprint-two-columns", "case": "fingerprint", "input": { "schema": [{"name":"a","type":"int"},{"name":"b","type":"float"}] }, "expected": { "verdict": "accept", "fingerprint": "09da452b" }, "answeredBy": ["reference"] },
    { "id": "fingerprint-with-unit", "case": "fingerprint", "input": { "schema": [{"name":"a","type":"int"},{"name":"b","type":"float","unit":"kg"}] }, "expected": { "verdict": "accept", "fingerprint": "a39cecf2" }, "answeredBy": ["reference"] },
    { "id": "fingerprint-with-label-kg", "case": "fingerprint", "input": { "schema": [{"name":"a","type":"int"},{"label":"kg","name":"b","type":"float"}] }, "expected": { "verdict": "accept", "fingerprint": "c9609d85" }, "answeredBy": ["reference"] },
    { "id": "fingerprint-with-empty-label", "case": "fingerprint", "input": { "schema": [{"label":"","name":"a","type":"int"}] }, "expected": { "verdict": "accept", "fingerprint": "3dc383ca" }, "answeredBy": ["reference"] },
