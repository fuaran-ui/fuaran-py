    {
      "id": "validate-defect-on-the-second-of-two-nodes-sharing-an-id",
      "description": "Two Switches share one id and only the SECOND has an empty stateKey (FUARAN083). A finding is located at the occurrence that raised it, so FUARAN083 is at $.kind.children[1], not at the first node holding the id. The first Switch's state key has no writer: FUARAN103, though judged across the whole tree, is raised by the Switch whose key it names, so it is at $.kind.children[0].",
      "tree": "{\"id\":\"root\",\"kind\":{\"$type\":\"Box\",\"children\":[{\"id\":\"sw\",\"kind\":{\"$type\":\"Switch\",\"cases\":[{\"child\":{\"id\":\"a1\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"}},\"match\":\"a\"}],\"default\":{\"id\":\"d1\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"}},\"stateKey\":\"k1\"}},{\"id\":\"sw\",\"kind\":{\"$type\":\"Switch\",\"cases\":[{\"child\":{\"id\":\"a2\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"}},\"match\":\"a\"}],\"default\":{\"id\":\"d2\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"}},\"stateKey\":\"\"}}],\"layout\":{\"$type\":\"Flex\",\"direction\":\"Vertical\"},\"role\":\"Group\"}}",
      "expected": [
        {
          "code": "FUARAN103",
          "severity": "Warning",
          "node": "sw",
          "path": "$.kind.children[0]"
        },
        {
          "code": "FUARAN-DUP-ID",
          "severity": "Error",
          "node": "sw",
          "path": "$.kind.children[1]"
        },
        {
          "code": "FUARAN083",
          "severity": "Warning",
          "node": "sw",
          "path": "$.kind.children[1]"
        }
      ]
    },
    {
