      "tree": "{\"id\":\"root\",\"kind\":{\"$type\":\"Switch\",\"cases\":[{\"child\":{\"id\":\"a\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"}},\"match\":\"x\"},{\"child\":{\"id\":\"b\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"}},\"match\":\"x\"},{\"child\":{\"id\":\"c\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"}},\"match\":\"x\"}],\"default\":{\"id\":\"d\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"}},\"stateKey\":\"k\"}}",
