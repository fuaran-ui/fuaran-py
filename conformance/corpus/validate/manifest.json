    {
      "id": "validate-duplicate-id-in-a-state-alternative-then-a-sibling",
      "description": "One id held by the onEmpty alternative of the first child and by the second child (FUARAN-DUP-ID). The alternative comes first in document order, so the one finding is at $.kind.children[1].",
      "tree": "{\"id\":\"root\",\"kind\":{\"$type\":\"Box\",\"children\":[{\"id\":\"c0\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"},\"state\":{\"onEmpty\":{\"id\":\"X\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"}}}},{\"id\":\"X\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"}}],\"layout\":{\"$type\":\"Flex\",\"direction\":\"Vertical\"},\"role\":\"Group\"}}",
      "expected": [
        {
          "code": "FUARAN-DUP-ID",
          "severity": "Error",
          "node": "X",
          "path": "$.kind.children[1]"
        }
      ]
    },
    {
      "id": "validate-switch-empty-statekey-in-a-state-alternative",
      "description": "A Switch with an empty stateKey (FUARAN083) held as the onLoading alternative of a child. Every rule judges a node in a state alternative as it judges one in the tree, so the finding is at $.kind.children[0].state.onLoading.",
      "tree": "{\"id\":\"root\",\"kind\":{\"$type\":\"Box\",\"children\":[{\"id\":\"c0\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"},\"state\":{\"onLoading\":{\"id\":\"s\",\"kind\":{\"$type\":\"Switch\",\"cases\":[{\"child\":{\"id\":\"sa\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"}},\"match\":\"a\"}],\"default\":{\"id\":\"sd\",\"kind\":{\"$type\":\"Markdown\",\"text\":\"t\"}},\"stateKey\":\"\"}}}}],\"layout\":{\"$type\":\"Flex\",\"direction\":\"Vertical\"},\"role\":\"Group\"}}",
      "expected": [
        {
          "code": "FUARAN083",
          "severity": "Warning",
